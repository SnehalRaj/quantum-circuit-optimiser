* text=auto
# Preserve every upstream byte, including the conditional compiler's CRLF lines.
vendor/** -text
data/** -text
paper/data/** -text
paper/studies/** -text
studies/historical/** -text
tests/fixtures/frontier/discovery/** -text whitespace=cr-at-eol
