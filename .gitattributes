evidence/frontier/**/*.log -text whitespace=-blank-at-eof
evidence/release-20261026/*.log -text whitespace=-blank-at-eof
vendor/frontier_rewrite/evidence/*.log whitespace=-blank-at-eof
*.gz -text
*.pdf -text
*.png -text
